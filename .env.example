# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih_fraud_detection

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Detection Settings
# Time window in days for incorporation burst detection
INCORPORATION_WINDOW_DAYS=30

# Weighted scoring configurations (must sum to 1.0)
WEIGHT_ADDRESS_SIGNAL=0.25
WEIGHT_DIRECTOR_SIGNAL=0.25
WEIGHT_TEMPORAL_SIGNAL=0.25
WEIGHT_FILING_SIGNAL=0.25
